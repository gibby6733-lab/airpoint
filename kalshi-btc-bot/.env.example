# Copy to .env (git-ignored). Never commit real keys.
# Kalshi API key (Kalshi > Account > API Keys). Only needed for live trading and --kalshi backtests.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/private_key.pem
# Alternatively inline PEM with \n line breaks:
# KALSHI_PRIVATE_KEY_PEM=

# Required (exact phrase from config.toml [live_gate]) to allow live trading. Leave empty for paper.
KALSHI_LIVE_CONFIRM=

# Required if the dashboard is exposed beyond localhost.
DASHBOARD_TOKEN=
