 "music": {"bpm": 120, "prog": "chill", "seed": 33, "mute": [[15, 20]]},
 "lines": [
  {"t": "What if you could hear your pet's thoughts?", "kw": ["PET'S", "THOUGHTS?"], "pause": 0.5},
  {"t": "You wake up. Your dog is staring at you.", "kw": ["DOG"], "pause": 0.3},
  {"t": "He's awake! He's awake! Best day of my life!", "voice": "am_puck", "speed": 1.2, "capColor": "#ffb84d", "kw": ["BEST", "DAY"], "pause": 0.4},
  {"t": "You go to the bathroom.", "pause": 0.3},
  {"t": "He left. He's never coming back. I'll wait by this door forever.", "voice": "am_puck", "speed": 1.0, "capColor": "#ffb84d", "kw": ["FOREVER."], "pause": 0.4},
  {"t": "You come back thirty seconds later.", "kw": ["THIRTY", "SECONDS"], "pause": 0.25},
  {"t": "He's back! Best day of my life!", "voice": "am_puck", "speed": 1.25, "capColor": "#ffb84d", "kw": ["BACK!"], "pause": 0.55},
  {"t": "Then you look at your cat.", "kw": ["CAT."], "pause": 0.4},
  {"t": "Oh. It's you.", "voice": "bf_emma", "speed": 0.9, "capColor": "#ff9ad5", "pause": 0.5},
  {"t": "Your cat has been watching you for years.", "pause": 0.3},
  {"t": "Day nine hundred. The human still thinks he owns me.", "cap": "Day 900. The human still thinks he owns me.", "voice": "bf_emma", "speed": 0.95, "capColor": "#ff9ad5", "kw": ["OWNS", "ME."], "pause": 0.45},
  {"t": "You give her breakfast.", "pause": 0.3},
  {"t": "Wrong bowl. Wrong flavor. Wrong human.", "voice": "bf_emma", "speed": 0.92, "capColor": "#ff9ad5", "kw": ["WRONG", "HUMAN."], "pause": 0.4},
  {"t": "She knocks your glass off the table.", "kw": ["GLASS"], "pause": 0.5},
  {"t": "That was a warning.", "voice": "bf_emma", "speed": 0.88, "capColor": "#ff9ad5", "kw": ["WARNING."], "pause": 0.6},
  {"t": "That night, you find her notebook.", "kw": ["NOTEBOOK."], "pause": 0.35},
  {"t": "It's called... Plan B.", "kw": ["PLAN", "B."], "pause": 0.45},
  {"t": "Step one: be cute. Step two: inherit the house.", "kw": ["INHERIT", "THE", "HOUSE."], "pause": 0.4},
  {"t": "There's a lawyer's business card.", "kw": ["LAWYER'S"], "pause": 0.3},
  {"t": "The lawyer... is also a cat.", "kw": ["ALSO", "A", "CAT."], "pause": 0.6},
  {"t": "So you try talking to your goldfish instead.", "kw": ["GOLDFISH"], "pause": 0.35},
  {"t": "Who are you? Oh! A castle!", "voice": "af_bella", "speed": 1.15, "capColor": "#7fd6ff", "kw": ["CASTLE!"], "pause": 0.45},
  {"t": "Who are you?", "voice": "af_bella", "speed": 1.1, "capColor": "#7fd6ff", "pause": 0.5},
  {"t": "Fair enough.", "pause": 0.5},
  {"t": "Then your dog walks in.", "pause": 0.3},
  {"t": "I love you. Also, I ate your homework. Also, I love you.", "voice": "am_puck", "speed": 1.1, "capColor": "#ffb84d", "kw": ["HOMEWORK."], "pause": 0.5},
  {"t": "Honestly?", "pause": 0.3},
  {"t": "Best roommate you've ever had.", "kw": ["BEST", "ROOMMATE"], "pause": 0.6},
  {"t": "I heard that.", "voice": "bf_emma", "speed": 0.85, "capColor": "#ff9ad5", "kw": ["HEARD"], "pause": 0}
