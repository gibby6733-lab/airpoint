   "lines": [
    {
     "who": "REGIONAL (V.O.)",
     "text": "Hal. Talk to me.",
     "start": 394.9,
     "end": 397.24
    },
    {
     "who": "FRINK",
     "text": "Forty-one states. A national cardboard shortage by Thursday. The product is an empty box made by children.",
