   "end": 361.11,
   "lines": [
    {
     "who": "BIG KEVIN",
     "text": "It's exactly what I needed.",
     "start": 358.14,
     "end": 360.59
    }
   ]
  },
  {
   "sc": 6,
   "shot": "6.3",
   "start": 361.11,
   "end": 370.14,
   "lines": [
    {
     "who": "YOGA MOM",
     "text": "I opened it, and for the first time in years… I didn't want anything.",
     "start": 361.51,
